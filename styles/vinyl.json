{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Vinyl",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "sleeve",
					"name": "Sleeve",
					"color": "#1B1E24"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#E7E9EC"
				},
				{
					"slug": "groove",
					"name": "Groove",
					"color": "#A2A9B8"
				},
				{
					"slug": "divider",
					"name": "Divider",
					"color": "#F2C12E"
				},
				{
					"slug": "sticker",
					"name": "Price sticker",
					"color": "#C2391F"
				},
				{
					"slug": "board",
					"name": "Board",
					"color": "#262A32"
				}
			]
		},
		"custom": {
			"onSold": "var(--wp--preset--color--sleeve)",
			"invalid": "#F0735C",
			"record": {
				"background": "#4A5163",
				"disc": "#111318",
				"label": "var(--wp--preset--color--divider)"
			}
		}
	},
	"styles": {
		"elements": {
			"button": {
				":hover": {
					"color": {
						"text": "#1B1E24"
					}
				},
				":focus": {
					"color": {
						"text": "#1B1E24"
					}
				}
			}
		}
	}
}
