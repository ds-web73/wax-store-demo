			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"custom": {
			"tab": {
				"radius": "6px",
				"bar": "6px"
			},
			"onDivider": "#1E2433",
			"onSticker": "#FFFFFF",
			"onSold": "#FFFFFF",
			"invalid": "var(--wp--preset--color--sticker)",
			"record": {
				"background": "var(--wp--preset--color--groove)",
				"disc": "var(--wp--preset--color--ink)",
				"label": "var(--wp--preset--color--divider)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--sleeve)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--archivo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.05",
					"fontFamily": "var(--wp--preset--font-family--archivo)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--sleeve)"
				},
				"border": {
					"radius": "3px"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "0.7em",
						"bottom": "0.7em",
						"left": "1.3em",
						"right": "1.3em"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--divider)",
						"text": "var(--wp--preset--color--ink)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--divider)",
						"text": "var(--wp--preset--color--ink)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "800",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "2px"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--source-serif)",
					"fontStyle": "italic",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--divider)",
						"width": "6px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.25rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--groove)"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without title",
			"postTypes": [
				"page"
			]
		}
	]
}
