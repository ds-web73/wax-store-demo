{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{
					"slug": "sleeve",
					"name": "Sleeve",
					"color": "#ECEEF0"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#1E2433"
				},
				{
					"slug": "groove",
					"name": "Groove",
					"color": "#4A5163"
				},
				{
					"slug": "divider",
					"name": "Divider",
					"color": "#F2C12E"
				},
				{
					"slug": "sticker",
					"name": "Price sticker",
					"color": "#C2391F"
				},
				{
					"slug": "board",
					"name": "Board",
					"color": "#FFFFFF"
				}
			],
			"defaultPalette": false,
			"defaultGradients": false,
			"gradients": [],
			"duotone": []
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Tiny",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "Small",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "clamp(1.25rem, 2vw, 1.75rem)"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "Extra large",
					"size": "clamp(3rem, 7vw, 5.5rem)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "archivo",
